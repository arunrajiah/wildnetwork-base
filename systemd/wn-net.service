[Unit]
Description=Wildlife Network Base network: home Wi-Fi first, hotspot as fallback
After=NetworkManager.service wnbase.service wn-firstboot.service
Wants=NetworkManager.service

[Service]
ExecStart=/usr/bin/python3 /opt/wnbase/wnnet.py --config /etc/wnbase/wnbase.ini
Restart=always
RestartSec=10
SyslogIdentifier=wn-net
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
