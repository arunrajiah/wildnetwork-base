[Unit]
Description=WildNetwork Base local service (dashboard and setup API)
After=network.target NetworkManager.service wn-firstboot.service
Wants=NetworkManager.service

[Service]
ExecStart=/usr/bin/python3 /opt/wnbase/wnbase.py --config /etc/wnbase/wnbase.ini
Restart=always
RestartSec=5
# Root: binds port 80, writes /etc/wdx-agent.ini and BirdNET-Go's config.yaml, runs nmcli, systemctl and docker.
User=root
NoNewPrivileges=yes
PrivateTmp=yes
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
